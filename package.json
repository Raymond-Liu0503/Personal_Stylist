{
  "name": "personal-stylist-native-backend",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "skills:build": "node scripts/compile-skills.mjs",
    "lint": "eslint .",
    "test:db": "supabase test db",
    "check:edge": "deno check --config supabase/functions/deno.json supabase/functions/api/index.ts",
    "test:edge": "deno test --allow-env --config supabase/functions/deno.json supabase/functions/_shared",
    "local:user": "node scripts/local-user.mjs",
    "backend:start": "supabase start",
    "backend:serve": "supabase functions serve api --env-file supabase/functions/.env"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "deno": "2.2.15",
    "eslint": "9.39.4",
    "supabase": "2.75.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0"
  },
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "2.99.1",
    "zod": "3.25.76"
  }
}
