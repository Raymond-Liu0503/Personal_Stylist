# Copy into the repository root as supabase/functions/.env.
# Backend repo on this Mac: /Users/raymondliu/Projects/Personal_Stylist
# These values are NOT read by the native iOS app.
APP_ENV=local
AI_PROVIDER=mock
MOCK_SCENARIO=success
ANALYSIS_ENABLED=true
OUTFIT_ENABLED=true
# Generate with: openssl rand -hex 32
REPORT_SIGNING_SECRET=REPLACE_ME

# Leave these empty for mock mode.
OPENROUTER_CONFIG_APPROVED=false
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_PROVIDERS=google-vertex/global
OPENROUTER_API_KEY=
# All additional profiles stay disabled until routes and image-token bounds are approved.
STYLIST_PROFILES_ENABLED=false
STYLIST_EVERYDAY_QUICK_ENABLED=false
STYLIST_EVERYDAY_DEEP_ENABLED=false
STYLIST_EXPERT_QUICK_ENABLED=false
STYLIST_EXPERT_DEEP_ENABLED=false
STYLIST_EVERYDAY_QUICK_INPUT_BOUND_APPROVED=false
STYLIST_EVERYDAY_DEEP_INPUT_BOUND_APPROVED=false
STYLIST_EXPERT_QUICK_INPUT_BOUND_APPROVED=false
STYLIST_EXPERT_DEEP_INPUT_BOUND_APPROVED=false
STYLIST_EVERYDAY_QUICK_LEGACY=false
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# The Supabase CLI injects SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY when it serves the function.
