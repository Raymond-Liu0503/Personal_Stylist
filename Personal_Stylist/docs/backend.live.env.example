# A template for real AI, NOT a second file the app automatically loads.
# Local: apply these settings to the repository root’s supabase/functions/.env.
# Hosted: create supabase/functions/.env.development in the repository root,
# then upload it with `npx supabase secrets set --env-file ...`.
APP_ENV=development
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_PROVIDERS=google-vertex/global
# Keep these false until the model/provider configuration is reviewed.
OPENROUTER_CONFIG_APPROVED=false
ANALYSIS_ENABLED=false
OUTFIT_ENABLED=false
STYLIST_PROFILES_ENABLED=false
STYLIST_EVERYDAY_QUICK_ENABLED=false
STYLIST_EVERYDAY_DEEP_ENABLED=false
STYLIST_EXPERT_QUICK_ENABLED=false
STYLIST_EXPERT_DEEP_ENABLED=false
STYLIST_EVERYDAY_QUICK_INPUT_BOUND_APPROVED=false
STYLIST_EVERYDAY_DEEP_INPUT_BOUND_APPROVED=false
STYLIST_EXPERT_QUICK_INPUT_BOUND_APPROVED=false
STYLIST_EXPERT_DEEP_INPUT_BOUND_APPROVED=false
STYLIST_EVERYDAY_QUICK_LEGACY=false
REPORT_SIGNING_SECRET=REPLACE_ME
# Needed for this app's Apple account-deletion/revocation flow.
APPLE_CLIENT_ID=com.personalstylist.beta
# A signed Apple client-secret JWT, not the raw .p8 file.
APPLE_CLIENT_SECRET=
